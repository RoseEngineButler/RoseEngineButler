                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="halign">start</property>
                            <property name="valign">start</property>
                            <property name="margin-left">4</property>
                            <property name="margin-right">4</property>
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                            <property name="margin-bottom">6</property>
                            <property name="label" translatable="yes">Every axis (X, Z, B, U, V, W) and both spindles (Sp0, Sp1) are driven by a bare stepper motor with no position or velocity sensor of any kind - LinuxCNC has no way to know whether a motor actually followed a step command. The P/I/D/FF values below don't correct real-world position error; they only shape how closely the stepgen's step timing tracks the motion planner's commanded trajectory internally. A step lost to mechanical or electrical interference is invisible to this system and will silently offset that axis until the next home. Good drive current/microstepping settings, mechanical rigidity, and clean wiring - not PID tuning - are what actually prevent missed steps.</property>
                            <property name="wrap">True</property>
                            <attributes>
                              <attribute name="font-desc" value="DejaVu Serif 10"/>
                            </attributes>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">5</property>
                          </packing>
