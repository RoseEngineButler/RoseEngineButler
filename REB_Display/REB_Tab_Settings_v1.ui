                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="tooltip-text" translatable="yes">Metric or Imperial units for the linear axes (X, Z, U, V, W). Changing this requires exiting and restarting LinuxCNC to take effect.</property>
